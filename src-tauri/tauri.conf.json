{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AIly",
  "version": "0.1.2",
  "identifier": "com.alphaeusng.aily",
  "build": {
    "frontendDist": "../apps/web"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "AIly — Your AI Ally",
        "width": 980,
        "height": 760,
        "resizable": true,
        "minWidth": 360,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false
      }
    },
    "shortDescription": "Your AI Ally",
    "longDescription": "Local-first companion for the targets you set. Unsigned dogfood: no OS app blocks in this build."
  }
}
